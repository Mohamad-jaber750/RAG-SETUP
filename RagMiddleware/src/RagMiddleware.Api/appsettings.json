{
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "rag_middleware"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RagApi": {
    "BaseUrl": "http://127.0.0.1:8000",
    "Timeout": "00:02:00"
  },
  "Jwt": {
    "Issuer": "RagMiddleware",
    "Audience": "RagFrontend",
    "SigningKey": "development-placeholder-use-user-secrets-only",
    "AccessTokenMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
